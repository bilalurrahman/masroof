{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Auth": {
    "RequireHttpsMetadata": false,
    "DevBypass": true,
    "DevUser": {
      "UserId": "00000000-0000-0000-0000-000000000001",
      "UserName": "Dev User",
      "Locale": "en",
      "Currency": "SAR"
    }
  },
  "Database": {
    "AutoMigrate": true
  }
}
